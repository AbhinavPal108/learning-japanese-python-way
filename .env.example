# Copy this file to .env and update values for your lab or deployment.
HOST=0.0.0.0
PORT=8080
# Keep the SQLite file inside the project for a local lab demo.
JP_LEARNING_DB=./data/learning_japanese.db
# This secret protects Japanese app partner endpoints.
# Leave blank only for a local, isolated demo.
PARTNER_API_KEY=
# Pomodoro server base URL and its shared bearer token.
# Keep the token server-side; never put it in frontend code.
POMODORO_URL=https://pomodoro-website-python-project-4dm0.onrender.com
STUDY_INTEGRATION_TOKEN=
# Comma-separated browser origins allowed to call the API. API-to-API calls do not use CORS.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
